{
  "name": "good-life-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "build:check": "vite build && node scripts/check-budget.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=2",
    "api:gen": "node scripts/gen-api.mjs",
    "fonts": "node scripts/subset-fonts.mjs",
    "e2e": "playwright test --pass-with-no-tests --project=iphone-13 --project=pixel-7",
    "e2e:pages": "playwright test --project=layout-390 --project=layout-360",
    "visual": "playwright test --pass-with-no-tests --project=visual"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
