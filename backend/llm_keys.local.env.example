# 模型服务实测的密钥文件模板。
# 用法：复制为 llm_keys.local.env（同一目录），把自己的密钥填到下面等号后面，再运行：
#     uv run python -m app.llm.live_check
# 重要：llm_keys.local.env 里是你的真实密钥，不要提交到仓库，也不要发给任何人。
#       本模板里的密钥位置一律留空，不要把密钥填回本模板。
# 没有填密钥的服务会被跳过，结果里写“未提供密钥”。
# 地址不填就用括号里写的预设地址；模型名不填的检查项会被跳过。
# 带引号或不带引号都可以，值的两端不要留空格。

# ---- 通义千问（预设地址 https://dashscope.aliyuncs.com/compatible-mode/v1）----
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_CHAT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-max
QWEN_TOOLS_MODEL=

# ---- DeepSeek（预设地址 https://api.deepseek.com/v1）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_CHAT_MODEL=deepseek-chat
# DeepSeek 的对话模型不能看图，看图项可以留空（会被跳过）
DEEPSEEK_VISION_MODEL=
DEEPSEEK_TOOLS_MODEL=

# ---- 豆包（预设地址 https://ark.cn-beijing.volces.com/api/v3）----
# 豆包要填写方舟控制台里的模型名或接入点编号（形如 ep- 开头），没有通用的默认名字
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_CHAT_MODEL=
DOUBAO_VISION_MODEL=
DOUBAO_TOOLS_MODEL=

# ---- 智谱（预设地址 https://open.bigmodel.cn/api/paas/v4）----
ZHIPU_API_KEY=
ZHIPU_BASE_URL=
ZHIPU_CHAT_MODEL=glm-4-plus
ZHIPU_VISION_MODEL=glm-4v-plus
ZHIPU_TOOLS_MODEL=

# ---- Claude（预设地址 https://api.anthropic.com）----
# 模型名请到 Anthropic 控制台或文档里查当前可用的名字
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_CHAT_MODEL=
CLAUDE_VISION_MODEL=
CLAUDE_TOOLS_MODEL=

# ---- Gemini（预设地址 https://generativelanguage.googleapis.com/v1beta）----
# 模型名请到 Google AI Studio 或文档里查当前可用的名字
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_CHAT_MODEL=
GEMINI_VISION_MODEL=
GEMINI_TOOLS_MODEL=

# ---- 通用兼容服务（任意其它服务，例如 OpenAI、自己部署的网关）----
# CUSTOM_KIND 必填，可选 openai_compatible、anthropic、gemini
# openai_compatible 类型必须填 CUSTOM_BASE_URL；anthropic 与 gemini 不填时用官方地址
CUSTOM_API_KEY=
CUSTOM_KIND=openai_compatible
CUSTOM_BASE_URL=
CUSTOM_CHAT_MODEL=
CUSTOM_VISION_MODEL=
CUSTOM_TOOLS_MODEL=
