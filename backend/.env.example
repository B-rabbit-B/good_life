DATABASE_URL=postgresql+psycopg://goodlife:goodlife@127.0.0.1:5433/goodlife
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
FIELD_ENCRYPTION_KEY=replace-with-output-of-the-fernet-generate-command-in-README
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 模型服务地址默认拒绝解析到内网或本机的主机；只有测试或本地模拟服务才设为 true
LLM_ALLOW_PRIVATE_HOSTS=false
# 调用模型服务的超时时间（秒）
LLM_TIMEOUT_SECONDS=20
# 高德开放平台的密钥，类型必须是“Web 服务”；留空表示关闭附近餐厅功能
AMAP_KEY=
# 高德服务地址；只有测试或本地模拟服务才需要改
AMAP_BASE_URL=https://restapi.amap.com
# 调用高德服务的超时时间（秒）
AMAP_TIMEOUT_SECONDS=8
