{
  "source": "各厂商公开文档，2026-10 整理，未逐个核实，可被用户覆盖",
  "rules": [
    {"pattern": "embed|rerank|(^|[^a-z])(tts|asr)([^a-z]|$)|whisper|speech|audio|transcribe|realtime|voice|moderation|image|dall-e|wanx|cogview|seedream|seedance|video",
     "vision": false, "tools": false, "chat": false,
     "note": "名称带有向量、重排、语音、图像或视频生成等字样，按非对话模型处理"},

    {"pattern": "qvq",
     "vision": true, "tools": null, "chat": true,
     "note": "通义千问 QVQ 视觉推理模型，支持看图；工具调用情况不确定"},
    {"pattern": "qwen[^/]*omni",
     "vision": true, "tools": null, "chat": true,
     "note": "通义千问 Omni 多模态模型，支持看图；工具调用情况不确定"},
    {"pattern": "qwen[^/]*[-_.]vl([-_.0-9]|$)",
     "vision": true, "tools": null, "chat": true,
     "note": "通义千问 VL 系列，支持看图；工具调用情况不确定"},
    {"pattern": "deepseek[^/]*[-_.]vl([-_.0-9]|$)",
     "vision": true, "tools": null, "chat": true,
     "note": "DeepSeek VL 系列，支持看图；工具调用情况不确定"},
    {"pattern": "glm-4([.][0-9]+)?v",
     "vision": true, "tools": null, "chat": true,
     "note": "智谱 GLM 视觉模型（带 v），支持看图；工具调用情况不确定"},
    {"pattern": "doubao[^/]*vision",
     "vision": true, "tools": null, "chat": true,
     "note": "豆包视觉模型，支持看图；工具调用情况不确定"},
    {"pattern": "doubao[-_ ]seed[-_ ]?1[.-]6",
     "vision": true, "tools": null, "chat": true,
     "note": "豆包 Seed 1.6 系列，支持看图；工具调用情况不确定"},
    {"pattern": "chatgpt-4o",
     "vision": true, "tools": null, "chat": true,
     "note": "ChatGPT 版 GPT-4o，支持看图；接口是否支持工具调用不确定"},
    {"pattern": "gpt-(4o|4[.]1|5)",
     "vision": true, "tools": true, "chat": true,
     "note": "OpenAI GPT-4o、GPT-4.1、GPT-5 系列，支持看图与工具调用"},
    {"pattern": "gpt-3[.]5",
     "vision": false, "tools": true, "chat": true,
     "note": "OpenAI GPT-3.5 系列，纯文字，支持工具调用"},
    {"pattern": "claude-",
     "vision": true, "tools": true, "chat": true,
     "note": "Anthropic Claude 系列，支持看图与工具调用"},
    {"pattern": "gemini-",
     "vision": true, "tools": true, "chat": true,
     "note": "Google Gemini 系列，支持看图与工具调用"},

    {"pattern": "deepseek[-/]?(chat|v3)",
     "vision": false, "tools": true, "chat": true,
     "note": "DeepSeek 对话模型，纯文字，支持工具调用"},
    {"pattern": "deepseek[-/]?(reasoner|r1)",
     "vision": false, "tools": null, "chat": true,
     "note": "DeepSeek 推理模型，纯文字；工具调用情况不确定"},
    {"pattern": "qwen-(max|plus|turbo|flash|long)",
     "vision": false, "tools": true, "chat": true,
     "note": "通义千问文字对话模型，纯文字，支持工具调用"},
    {"pattern": "qwen3",
     "vision": false, "tools": true, "chat": true,
     "note": "通义千问 3 文字模型，纯文字，支持工具调用"},
    {"pattern": "qwen2[.]5",
     "vision": false, "tools": true, "chat": true,
     "note": "通义千问 2.5 文字模型，纯文字，支持工具调用"},
    {"pattern": "qwq",
     "vision": false, "tools": null, "chat": true,
     "note": "通义千问 QwQ 推理模型，纯文字；工具调用情况不确定"},
    {"pattern": "glm-z1",
     "vision": false, "tools": null, "chat": true,
     "note": "智谱 GLM-Z1 推理模型，纯文字；工具调用情况不确定"},
    {"pattern": "glm-4",
     "vision": false, "tools": true, "chat": true,
     "note": "智谱 GLM-4 系列文字模型（不带 v），纯文字，支持工具调用"},
    {"pattern": "doubao[^/]*(pro|lite)",
     "vision": false, "tools": true, "chat": true,
     "note": "豆包 pro、lite 文字模型，纯文字，支持工具调用"}
  ]
}
